{
  "name": "liveops-backend",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
      "lint": "eslint --ext .js,.jsx,.ts,.tsx src",
      "lint:md": "markdownlint-cli2 '../**/*.md' --config ../../.markdownlint.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.{ts,json,md}",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "validate:store-items": "ts-node scripts/validate-store-items-schema.ts",
    "test:shop": "jest tests/shop.test.ts",
    "test:coverage": "jest --coverage",
    "stress:smoke": "pnpm exec tsx scripts/stress/run-autocannon.ts smoke",
    "stress:spike": "pnpm exec tsx scripts/stress/run-autocannon.ts spike",
    "stress:soak": "pnpm exec tsx scripts/stress/run-autocannon.ts soak",
    "stress:local:smoke": "pnpm exec tsx scripts/stress/run-local-smoke.ts",
    "stress:local:spike": "pnpm exec tsx scripts/stress/run-local-smoke.ts spike",
    "stress:local:soak": "pnpm exec tsx scripts/stress/run-local-smoke.ts soak",
    "stress:local:soak:quick": "pnpm exec tsx scripts/stress/run-local-smoke.ts soak 90",
    "stress:summary": "pnpm exec tsx scripts/stress/summarize-report.ts",
    "stress:validate:canonical": "pnpm exec tsx scripts/stress/validate-canonical-result.ts",
    "stress:labels:bootstrap": "pnpm exec tsx scripts/stress/bootstrap-github-labels.ts",
    "workflow:dispatch:weekly-reliability": "pnpm exec tsx scripts/stress/dispatch-workflow.ts backend-weekly-reliability.yml",
    "workflow:dispatch:label-bootstrap": "pnpm exec tsx scripts/stress/dispatch-workflow.ts backend-label-bootstrap.yml",
    "workflow:dispatch-wait:weekly-reliability": "pnpm exec tsx scripts/stress/poll-workflow-run.ts backend-weekly-reliability.yml --dispatch --output stress-artifacts/workflow-run-weekly-reliability.json",
    "workflow:dispatch-wait:label-bootstrap": "pnpm exec tsx scripts/stress/poll-workflow-run.ts backend-label-bootstrap.yml --dispatch --output stress-artifacts/workflow-run-label-bootstrap.json",
    "license:generate": "pnpm exec tsx scripts/licensing/generate-license.ts",
    "license:hash": "pnpm exec tsx scripts/licensing/hash-license.ts",
    "license:revoke": "pnpm exec tsx scripts/licensing/revoke-license.ts",
    "license:validate-revocations": "pnpm exec tsx scripts/licensing/validate-revocations.ts",
    "license:summarize-events": "pnpm exec tsx scripts/licensing/summarize-license-events.ts",
    "license:export-events": "pnpm exec tsx scripts/licensing/export-license-event-artifacts.ts",
    "liveops:event:pipeline": "pnpm exec tsx scripts/liveops/run-event-pipeline.ts",
    "liveops:regression:channels": "pnpm exec tsx scripts/liveops/run-channel-regression.ts",
    "liveops:deploy:rollback": "pnpm exec tsx scripts/liveops/run-deploy-rollback-drill.ts",
    "liveops:offline:core": "pnpm exec tsx scripts/liveops/run-offline-core-workflows.ts",
    "liveops:cloud:failover": "pnpm exec tsx scripts/liveops/run-cloud-failover-drill.ts",
    "liveops:secrets:rotation": "pnpm exec tsx scripts/liveops/run-secrets-rotation-drill.ts",
    "liveops:agent:handoff": "pnpm exec tsx scripts/liveops/run-agent-handoff-drill.ts",
    "liveops:agent:concurrency": "pnpm exec tsx scripts/liveops/run-agent-concurrency-drill.ts",
    "liveops:agent:slo": "pnpm exec tsx scripts/liveops/run-agent-slo-drill.ts",
    "liveops:agent:contracts": "pnpm exec tsx scripts/liveops/run-agent-contract-drill.ts",
    "liveops:ai:debug-loop": "pnpm exec tsx scripts/liveops/run-ai-debug-loop-drill.ts",
    "liveops:ai:approval-gate": "pnpm exec tsx scripts/liveops/run-ai-approval-gate-drill.ts",
    "liveops:no-code:composer": "pnpm exec tsx scripts/liveops/run-no-code-composer-drill.ts",
    "liveops:no-code:economy-sim": "pnpm exec tsx scripts/liveops/run-no-code-economy-simulation-drill.ts",
    "liveops:no-code:rollout-safety": "pnpm exec tsx scripts/liveops/run-no-code-rollout-safety-drill.ts",
    "liveops:license:revocation-rotation": "pnpm exec tsx scripts/liveops/run-license-revocation-rotation-drill.ts",
    "liveops:license:strict-staging": "pnpm exec tsx scripts/liveops/run-license-strict-staging-drill.ts",
    "docs:check-links": "pnpm exec tsx scripts/docs/check-markdown-links.ts",
    "prepare": "husky install",
    "prisma:migrate": "pnpm exec prisma migrate dev --name add-enemy-template --schema=prisma/schema.prisma --config=prisma/prisma.config.ts",
    "prisma:generate": "pnpm exec prisma generate --schema=prisma/schema.prisma --config=prisma/prisma.config.ts",
    "seed:enemy-templates": "pnpm exec tsx scripts/seed-enemy-templates.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "ajv": "^8.18.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "i18next": "^25.8.10",
    "i18next-fs-backend": "^2.6.1",
    "i18next-http-middleware": "^3.9.2",
    "json2csv": "6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.0",
    "pg": "^8.11.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@prisma/client": "6.19.2",
    "@types/autocannon": "^7.12.7",
    "@types/axios": "^0.9.36",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^8.2.3",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^6.0.2",
    "@types/helmet": "^4.0.0",
    "@types/i18next": "^13.0.0",
    "@types/jest": "^30.0.0",
    "@types/json2csv": "^5.0.7",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.17",
    "@types/pg": "^8.6.6",
    "@types/pino": "^7.0.4",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "autocannon": "^8.0.0",
    "axios": "^1.13.5",
    "husky": "^9.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-fetch-mock": "^3.0.3",
    "lint-staged": "^15.0.0",
    "pino": "^10.3.1",
    "prisma": "6.19.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3"
  },
  "lint-staged": {
    "*.{js,ts,json,md}": [
      "prettier --write",
      "eslint --fix",
      "git add"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}
