# Default local database name. Keep aligned with DATABASE_URL.
POSEIDON_DB_NAME=liveops
DATABASE_URL=postgres://user:password@localhost:5432/liveops
JWT_SECRET=your_jwt_secret

# Poseidon enterprise licensing
# Modes: off | warn | strict
POSEIDON_LICENSE_ENFORCEMENT=warn
# HMAC secret used to verify signed license payloads
POSEIDON_LICENSE_SECRET=change_me_for_production
# Optional fallback license key (can also be sent per-request via x-poseidon-license)
POSEIDON_LICENSE_KEY=
# Optional comma-separated exempt route prefixes (defaults include /healthz,/system-health,/auth,/api-docs)
POSEIDON_LICENSE_EXEMPT_PATHS=
# Optional comma-separated SHA256 hashes of revoked normalized license keys
POSEIDON_LICENSE_REVOKED_HASHES=
