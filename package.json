{
  "name": "frontend-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "Monorepo for web, mobile, and shared packages",
  "packageManager": "pnpm@10.29.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --recursive run dev",
    "build": "pnpm --filter '!apps/poseidon-ui' run build",
    "build:poseidon-ui": "pnpm --dir apps/poseidon-ui run build:package",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx apps/**/src packages/**/src",
    "lint:md": "markdownlint-cli2 '**/*.md' --config .markdownlint.json",
    "audit:prod": "pnpm audit --prod --audit-level=moderate",
    "audit:all": "pnpm audit --audit-level=moderate",
    "test": "pnpm --recursive run test",
    "e2e:cypress:endurance": "node e2e/cypress/run-endurance.mjs --duration-seconds=3600 --fail-fast",
    "e2e:cypress:endurance:quick": "node e2e/cypress/run-endurance.mjs --duration-seconds=300 --max-runs=2 --fail-fast",
    "e2e:detox:endurance": "node e2e/detox/run-endurance.mjs --duration-seconds=3600 --fail-fast --configuration=android.emu.debug",
    "e2e:detox:endurance:quick": "node e2e/detox/run-endurance.mjs --duration-seconds=300 --max-runs=1 --fail-fast --configuration=android.emu.debug",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "npx chromatic --project-token <replace-with-your-token>",
    "setup": "pnpm install && pnpm build -r && pnpm lint -r && pnpm type-check -r",
    "prepare": "husky install",
    "legal:check-release-records": "node scripts/legal/check-release-records.mjs",
    "governance:check-branch-protection-template": "node scripts/governance/check-branch-protection-audit-template.mjs",
    "governance:check-closeout": "node scripts/governance/check-go-live-closeout.mjs",
    "governance:check-closeout:strict": "node scripts/governance/check-go-live-closeout.mjs --strict",
    "governance:check-elite-readiness": "node scripts/governance/check-elite-readiness.mjs",
    "governance:check-elite-readiness:strict": "node scripts/governance/check-elite-readiness.mjs --strict --target=elite",
    "governance:check-launch-readiness:strict": "node scripts/governance/check-elite-readiness.mjs --strict --target=launch",
    "governance:check-mono-contracts": "node scripts/governance/check-mono-contract-compatibility.mjs",
    "governance:check-mono-contracts:strict": "node scripts/governance/check-mono-contract-compatibility.mjs --strict",
    "governance:check-mono-release-lanes": "node scripts/governance/check-mono-release-lanes.mjs",
    "governance:check-mono-release-lanes:strict": "node scripts/governance/check-mono-release-lanes.mjs --strict",
    "governance:check-mono-supply-chain": "node scripts/governance/check-mono-supply-chain.mjs",
    "governance:check-mono-supply-chain:strict": "node scripts/governance/check-mono-supply-chain.mjs --strict",
    "governance:check-release-distribution-provenance-policy": "node scripts/governance/check-release-distribution-provenance-policy.mjs",
    "governance:check-license-anomaly-policy": "node scripts/governance/check-license-anomaly-escalation-policy.mjs",
    "governance:validate-license-anomaly-policy-report": "node scripts/governance/validate-license-anomaly-policy-report.mjs",
    "governance:test-license-anomaly-policy-report-validator": "node scripts/governance/test-validate-license-anomaly-policy-report.mjs",
    "governance:generate-executive-snapshot": "node scripts/governance/generate-governance-executive-snapshot.mjs",
    "governance:validate-executive-snapshot": "node scripts/governance/validate-governance-executive-snapshot.mjs",
    "governance:test-executive-snapshot-validator": "node scripts/governance/test-validate-governance-executive-snapshot.mjs",
    "governance:generate-executive-trend": "node scripts/governance/generate-governance-executive-trend.mjs",
    "governance:validate-executive-trend": "node scripts/governance/validate-governance-executive-trend.mjs",
    "governance:validate-release-environment-audit-report": "node scripts/governance/validate-release-environment-audit-report.mjs",
    "governance:generate-elite-board": "node scripts/governance/generate-elite-execution-board.mjs",
    "release:provenance": "node scripts/release/generate-provenance-manifest.mjs",
    "backend:liveops:event:pipeline": "pnpm --dir backend run liveops:event:pipeline",
    "backend:liveops:regression:channels": "pnpm --dir backend run liveops:regression:channels",
    "backend:liveops:deploy:rollback": "pnpm --dir backend run liveops:deploy:rollback",
    "backend:liveops:offline:core": "pnpm --dir backend run liveops:offline:core",
    "backend:liveops:cloud:failover": "pnpm --dir backend run liveops:cloud:failover",
    "backend:liveops:secrets:rotation": "pnpm --dir backend run liveops:secrets:rotation",
    "backend:liveops:agent:handoff": "pnpm --dir backend run liveops:agent:handoff",
    "backend:liveops:agent:concurrency": "pnpm --dir backend run liveops:agent:concurrency",
    "backend:liveops:agent:slo": "pnpm --dir backend run liveops:agent:slo",
    "backend:liveops:agent:contracts": "pnpm --dir backend run liveops:agent:contracts",
    "backend:liveops:ai:debug-loop": "pnpm --dir backend run liveops:ai:debug-loop",
    "backend:liveops:ai:approval-gate": "pnpm --dir backend run liveops:ai:approval-gate",
    "backend:liveops:no-code:composer": "pnpm --dir backend run liveops:no-code:composer",
    "backend:liveops:no-code:economy-sim": "pnpm --dir backend run liveops:no-code:economy-sim",
    "backend:liveops:no-code:rollout-safety": "pnpm --dir backend run liveops:no-code:rollout-safety",
    "backend:liveops:license:revocation-rotation": "pnpm --dir backend run liveops:license:revocation-rotation",
    "backend:liveops:license:strict-staging": "pnpm --dir backend run liveops:license:strict-staging"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.33.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@expo/vector-icons": "^15.0.3",
    "@mui/icons-material": "^7.3.8",
    "@mui/material": "^7.3.8",
    "@prisma/client": "6.19.2",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-firebase/analytics": "^23.8.6",
    "@react-navigation/stack": "^7.7.1",
    "@sentry/browser": "^10.39.0",
    "@sentry/react": "^10.39.0",
    "@sentry/react-native": "^8.0.0",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@types/react-native": "^0.72.8",
    "expo": "^54.0.33",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-fetch-mock": "^3.0.3",
    "k6": "^0.0.0",
    "prettier": "^3.8.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-dropzone": "^15.0.0",
    "react-icons": "^5.5.0",
    "react-native": "0.84.0",
    "react-query": "^3.39.3",
    "react-router-dom": "^7.13.0",
    "ts-jest": "^29.4.6",
    "vite": "^7.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.2.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "cypress": "^15.10.0",
    "eslint": "^10.0.0",
    "eslint-plugin-i18next": "^6.1.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "espree": "^11.1.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "markdownlint-cli2": "^0.21.0",
    "turbo": "^2.8.9",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,md,json,css,scss,html}": [
      "prettier --write",
      "eslint --fix",
      "git add"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}
